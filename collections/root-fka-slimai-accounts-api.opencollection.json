              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Before cursor for previous page"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size (max 1000)"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Ordering (e.g., 'created_at:desc')"
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Filter by email"
              },
              {
                "name": "role",
                "value": "",
                "type": "query",
                "description": "Filter by role (admin, member, readonly)"
              }
            ]
          },
          "docs": "List accounts in an organization with cursor-based pagination"
        },
        {
          "info": {
            "name": "Update account",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/v3/accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Account ID"
              }
            ]
          },
          "docs": "Update account role (org-scoped)"
        },
        {
          "info": {
            "name": "Delete account",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v3/accounts/:account_id",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "Account ID"
              }
            ]
          },
          "docs": "Delete an account from the organization"
        },
        {
          "info": {
            "name": "Get current user's account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/me"
          },
