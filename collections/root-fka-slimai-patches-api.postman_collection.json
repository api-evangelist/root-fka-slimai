        {
          "id": "ca8908ff-fbfb-455f-b597-2f1ea7aad3f6",
          "name": "List CVE tickets (patches)",
          "request": {
            "name": "List CVE tickets (patches)",
            "description": {
              "content": "List and search CVE tickets with filters, org-scoped for non-superadmins. Returns patch status (found, not_found, running) by checking Argo workflows.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "patches"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cve_id",
                  "value": "<string>",
                  "description": "Filter by CVE ID"
                },
                {
                  "disabled": false,
                  "key": "package_src_name",
                  "value": "<string>",
                  "description": "Filter by package source name"
                },
                {
                  "disabled": false,
                  "key": "ecosystem",
                  "value": "<string>",
                  "description": "Filter by ecosystem"
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "Filter by package version (for app tickets)"
                },
                {
                  "disabled": false,
                  "key": "os_distro_major",
                  "value": "<string>",
                  "description": "Filter by OS distro major version (for OS tickets)"
                },
                {
                  "disabled": false,
                  "key": "severities",
                  "value": "<string>,<string>",
                  "description": "Filter by severities (critical, high, medium, low)"
                },
                {
                  "disabled": false,
                  "key": "ticket_statuses",
                  "value": "<string>,<string>",
                  "description": "Filter by ticket statuses (open, in_progress, done, deferred)"
                },
                {
                  "disabled": false,
                  "key": "patch_status",
                  "value": "<string>",
                  "description": "Filter by patch status (found, not_found, running)"
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>,<string>",
                  "description": "Ordering (e.g., 'created_at:desc')"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "Cursor for pagination"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Page size (default 100, max 1000)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
