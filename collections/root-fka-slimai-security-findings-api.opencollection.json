        },
        {
          "info": {
            "name": "Get security findings daily summary (counts by day, status, and severity)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v3/security_findings/summary/daily",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of most recent days to include (default 84 / 12 weeks, max 365). Ignored when created_at_gte or created_at_lt is set."
              },
              {
                "name": "created_at_gte",
                "value": "",
                "type": "query",
                "description": "Filter: created_at >= (RFC3339 timestamp)"
              },
              {
                "name": "created_at_lt",
                "value": "",
                "type": "query",
                "description": "Filter: created_at < (RFC3339 timestamp)"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Ordering (e.g., 'created_at:desc')"
              },
              {
                "name": "supported_ecosystem",
                "value": "",
                "type": "query",
                "description": "Filter by supported ecosystem status (true = supported ecosystem, false = non-supported ecosystem)"
              }
            ]
          },
          "docs": "Returns finding counts grouped by day, status, and severity. Use created_at_gte/created_at_lt for an explicit date range, or limit for the most recent N days (mutually exclusive; date range takes precedence)."
        }
